scala_library(
    dependencies = [
        ":quantile_features_data_records-java",
        "3rdparty/src/jvm/com/twitter/scalding:core",
        "agatha/src/main/scala/com/twitter/agatha/scalding:agatha_quantile_features-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/data:active_user_features-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels:agatha_label_manager",
        "hub/agatha/src/main/scala/com/twitter/hub/agatha/job",
        "hub/agatha/src/main/scala/com/twitter/hub/agatha/labels",
        "hub/agatha/src/main/thrift/com/twitter/hub/agatha:agatha-scala",
        "hub/util/src/tests/scala/com/twitter/hub/util/metadata_source",
        "src/scala/com/twitter/scalding_internal/dalv2",
        "src/scala/com/twitter/scalding_internal/dalv2/dataset",
    ],
    platform = "java8",
    sources = ["*.scala"],
    strict_deps = False,
    tags = ["bazel-compatible"],
)

create_datarecord_datasets(
    base_name = "quantile_features_data_records",
    platform = "java8",
    role = "agatha",
    segment_type = "snapshot",
    tags = ["bazel-compatible"],
)

hadoop_binary(
    name = "quantile-feature-export-bin",
    dependencies = [":quantile"],
    main = "com.twitter.agatha.scalding.quantile.ScheduledQuantileFeatureExportJob",
    platform = "java8",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible",
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)

scalding_job(
    name = "quantile_feature_export",
    args = ["--tz UTC --batch_timeout 172800 --batchFirstTime 2020-11-03 --increment 3 --batchDesc QuantileFeatureExport"],
    config = [
        ("hadoop.combine-input", "true"),
        ("hadoop.map.jvm.total-memory", "3072m"),
        ("hadoop.queue", "agatha.tier3"),
        ("hadoop.reduce.jvm.total-memory", "3072m"),
        ("hadoop.split-size", "1073741824"),
        ("hadoop.submitter.jvm.total-memory", "5120m"),
    ],
    contact = "agatha-owners@twitter.com",
    cron = "0 * * * *",
    dependencies = [":quantile"],
    hadoop_cluster = "atla-proc",
    hadoop_properties = [
        ("scalding.auto_tuning.estimator.reducer.max.estimated", "10000"),
        ("scalding.reducer.estimator.max.estimated.reducers", "10000"),
    ],
    main = "com.twitter.agatha.scalding.quantile.ScheduledQuantileFeatureExportJob",
    platform = "java8",
    role = "agatha",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)
