hadoop_binary(
    name = "spam-suspended-bin",
    dependencies = [":spam_suspended"],
    main = "com.twitter.agatha.scalding.labels.spam_suspended.ScheduledSpamSuspendedExtractionJob",
    platform = "java8",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible",
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)

create_datasets(
    base_name = "spam_suspended_user_label",
    java_dependencies = ["hub/agatha/src/main/thrift/com/twitter/hub/agatha:agatha-java"],
    java_schema = "com.twitter.hub.agatha.thriftjava.UserLabel",
    platform = "java8",
    role = "agatha",
    scala_dependencies = ["hub/agatha/src/main/thrift/com/twitter/hub/agatha:agatha-scala"],
    scala_schema = "com.twitter.hub.agatha.thriftscala.UserLabel",
    segment_type = "snapshot",
    tags = ["bazel-compatible"],
)

scalding_job(
    name = "spam_suspended_labels",
    args = ["--tz UTC --batch_timeout 259200 --batchFirstTime 2020-10-18 --increment 7 --batchDesc SpamSuspendedLabels"],
    config = [
        ("hadoop.combine-input", "true"),
        ("hadoop.data-per-reducer", "536870912"),
        ("hadoop.map.jvm.total-memory", "3072m"),
        ("hadoop.queue", "agatha.tier3"),
        ("hadoop.reduce.jvm.total-memory", "3072m"),
        ("hadoop.split-size", "1073741824"),
        ("hadoop.submitter.jvm.total-memory", "5120m"),
    ],
    contact = "agatha-owners@twitter.com",
    cron = "0 * * * *",
    dependencies = [":spam_suspended"],
    hadoop_cluster = "atla-proc",
    hadoop_properties = [("scalding.reducer.estimator.max.estimated.reducers", "10000")],
    main = "com.twitter.agatha.scalding.labels.spam_suspended.ScheduledSpamSuspendedExtractionJob",
    platform = "java8",
    role = "agatha",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible",
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)
