scala_library(
    dependencies = [
        ":spam_suspended_user_label-scala",
        "3rdparty/src/jvm/com/twitter/scalding:core",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels:label_extraction_template",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels:label_util",
        "agatha/src/main/scala/com/twitter/agatha/scalding/util",
        "hub/agatha/src/main/scala/com/twitter/hub/agatha/labels:label-generator",
        "hub/agatha/src/main/thrift/com/twitter/hub/agatha:agatha-scala",
        "src/scala/com/twitter/scalding_internal/job/analytics_batch",
        "twadoop_config/configuration/log_categories/group/useng:audit_service_user_actions-scala",
        "usersource/snapshot/src/main/scala/com/twitter/usersource/snapshot/combined:usersource-scala",
    ],
    platform = "java8",
    sources = [
        "SpamSuspendedLabel.scala",
        "SpamSuspendedLabelExtraction.scala",
    ],
    strict_deps = False,
    tags = ["bazel-compatible"],
