    ],
    platform = "java8",
    sources = [
        "RateBasedLabels.scala",
        "RateBasedLabelsExtraction.scala",
    ],
    strict_deps = False,
    tags = [
        "bazel-compatible",
        "bazel-only",
    ],
)

hadoop_binary(
    name = "rate-based-label-bin",
    dependencies = [
        ":rate_based_labels",
        "science/scalding/scripts:scalding-repl-deps",
    ],
    main = "com.twitter.agatha.scalding.labels.rate_based_labels.ScheduledRateBasedExtractionJob",
    platform = "java8",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible",
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)

scalding_job(
    name = "rate_based_labels_job",
    args = ["--tz UTC --batch_timeout 259200 --batchFirstTime 2020-10-22 --increment 7 --batchDesc RateBasedLabels"],
    config = [
        ("hadoop.combine-input", "true"),
        ("hadoop.map.jvm.total-memory", "3072m"),
        ("hadoop.queue", "agatha.tier3"),
        ("hadoop.reduce.jvm.total-memory", "3072m"),
        ("hadoop.split-size", "1073741824"),
        ("hadoop.submitter.jvm.total-memory", "5120m"),
    ],
    contact = "agatha-owners@twitter.com",
    cron = "0 * * * *",
    dependencies = [
        ":rate_based_labels",
        "science/scalding/scripts:scalding-repl-deps",
    ],
    hadoop_cluster = "atla-proc",
    hadoop_properties = [
        ("scalding.auto_tuning.estimator.reducer.max.estimated", "10000"),
        ("scalding.reducer.estimator.max.estimated.reducers", "10000"),
    ],
    main = "com.twitter.agatha.scalding.labels.rate_based_labels.ScheduledRateBasedExtractionJob",
    platform = "java8",
    role = "agatha",
    runtime_platform = "java8",
    tags = [
        "bazel-compatible:migrated",
        "bazel-only",
    ],
)
