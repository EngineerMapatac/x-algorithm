        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/reports_per_fav:mention_filtered_reports_per_fav_user_label-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/reports_per_fav:reports_per_fav_user_label-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/spam_reports_per_fav",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/spam_reports_per_fav:all_spam_reports_per_fav_user_label-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/spam_reports_per_fav:spam_reports_per_fav_user_label-scala",
        "graphstore/common:flock_blocks-java",
        "hub/agatha/src/main/scala/com/twitter/hub/agatha/labels:label-generator",
        "hub/agatha/src/main/scala/com/twitter/hub/agatha/labels:label-util",
        "hub/agatha/src/main/thrift/com/twitter/hub/agatha:agatha-scala",
        "src/scala/com/twitter/common_internal/analytics/artificial_user_filter",
        "src/scala/com/twitter/spam/scalding/datasets:tattle_events-scala",
        "src/thrift/com/twitter/spam:spam-scala",
