        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/blocks_per_fav",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/blocks_per_fav:blocks_per_fav_user_label-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/blocks_per_fav:mention_filtered_blocks_per_fav_user_label-scala",
        "agatha/src/main/scala/com/twitter/agatha/scalding/labels/favs",
